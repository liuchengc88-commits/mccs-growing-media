{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "python -u -m http.server 4173",
      "startServerReadyPattern": "Serving HTTP",
      "startServerReadyTimeout": 10000,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/products/",
        "http://127.0.0.1:4173/sample-shipping/",
        "http://127.0.0.1:4173/contact/",
        "http://127.0.0.1:4173/insights/hydroponic-grow-plug-guide/",
        "http://127.0.0.1:4173/applications/root-development-gallery/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.8}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
