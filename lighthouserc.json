{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "https://www.mccsgrowingmedia.com/",
        "https://www.mccsgrowingmedia.com/products/",
        "https://www.mccsgrowingmedia.com/sample-shipping/",
        "https://www.mccsgrowingmedia.com/contact/",
        "https://www.mccsgrowingmedia.com/insights/hydroponic-grow-plug-guide/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.8}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

