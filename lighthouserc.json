{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "https://www.mccsgrowingmedia.com/",
        "https://www.mccsgrowingmedia.com/products/",
        "https://www.mccsgrowingmedia.com/sample-shipping/",
        "https://www.mccsgrowingmedia.com/contact/",
        "https://www.mccsgrowingmedia.com/insights/hydroponic-grow-plug-guide/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.65}],
        "categories:accessibility": ["warn", {"minScore": 0.85}],
        "categories:best-practices": ["warn", {"minScore": 0.85}],
        "categories:seo": ["warn", {"minScore": 0.9}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

